# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE - ELECTRICAL RETAIL STORE PLATFORM
# ==============================================================================
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/electrical_store_dev

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (NEXTAUTH / AUTH.JS)
# ------------------------------------------------------------------------------
# Base URL of the application
NEXTAUTH_URL=http://localhost:3000
# A secure, random 32+ character string used to encrypt JWT session tokens.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_a_secure_random_32_character_secret_key

# ------------------------------------------------------------------------------
# 4. CLOUDINARY CONFIGURATION (PHASE 1 ARCHITECTURE READY)
# ------------------------------------------------------------------------------
# Required for media asset management in future phases
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. RAZORPAY CONFIGURATION (PHASE 1 ARCHITECTURE READY)
# ------------------------------------------------------------------------------
# Server-side Razorpay integration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Secret configured for the Razorpay webhook endpoint
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 6. CHECKOUT / DELIVERY CONFIGURATION
# ------------------------------------------------------------------------------
# Temporary flat shipping charge in paise. Keep at 0 until the client's
# delivery-charge policy is confirmed.
SHIPPING_FLAT_RATE_PAISE=0
# Inventory reservation window while a customer is paying (5-30 minutes).
PAYMENT_RESERVATION_MINUTES=10
